# Compatible GraphQL endpoint implementing the existing _v1 operations.
VITE_HOST=http://localhost:4000/graphql
VITE_BASE_PATH=/
VITE_DEFAULT_USER_PATH=/user/dashboard

# Keep legacy until the backend implements the HttpOnly contract in docs/http-only.md.
VITE_AUTH_MODE=legacy
# Required only in http-only mode; set these to your backend's actual endpoints.
# VITE_SESSION_REFRESH_URL=https://api.example.com/auth/session/refresh
# VITE_SESSION_LOGOUT_URL=https://api.example.com/auth/session/logout
